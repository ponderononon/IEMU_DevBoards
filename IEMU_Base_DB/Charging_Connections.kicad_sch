	(text "Series Resistors as \nprotection against \nback-power"
		(exclude_from_sim no)
		(at 193.294 62.738 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "05b2458f-b902-4e77-b2cd-271523906bef")
	)
	(text "Allows to only power the dock,\nwhen a sensor is actually present.\nOr e.g. turn power off, when sensor is fully charged."
		(exclude_from_sim no)
		(at 128.016 36.576 0)
		(effects
			(font
				(size 0.8 0.8)
			)
		)
		(uuid "071d390c-807e-475d-adb9-1e7ad1e580c6")
	)
	(text "ILIM to Vin sets charging current to 75mA. \nThe batteries currently planned with\nhave a max charging current of 85mA."
		(exclude_from_sim no)
		(at 142.24 44.196 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "10b45642-78a5-425c-8c26-c06c606d28a0")
	)
	(text "Pin2 - GND"
		(exclude_from_sim no)
		(at 261.62 51.054 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "3b6368d5-b932-4c1b-8142-550bfb07ca54")
	)
	(text "Charging Connections"
		(exclude_from_sim no)
		(at 50.292 19.558 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 1.016)
				(bold yes)
			)
		)
		(uuid "3e0da697-283d-497a-a389-1840fceb647b")
	)
	(text "Detect line is pulled high with 47k.\nOn the sensor it is pulled low with 10k.\nBASE will have an interupt setup to recognize,\nwhen sensor gets plugged in.\nBASE reads 1.8V -> logic high, when unconnected.\nBASE reads ~0.31V -> logic low, when connected.\n\n(Sensor will detect the connection via LPCOMP,\ngoing from 0V to ~0.31V)"
		(exclude_from_sim no)
		(at 207.772 28.448 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left)
		)
		(uuid "413b29df-0a2f-4025-91f1-6d14c732946d")
	)
	(text "TPS2553DRVT includes ESD Protection"
		(exclude_from_sim no)
		(at 217.678 45.974 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "64d016b5-a351-4437-81b5-03feca7bd299")
	)
	(text "Pin4 - UART (one way)"
		(exclude_from_sim no)
		(at 261.62 56.134 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "6568c80e-dfd8-465a-ae24-2b3b8ff47250")
	)
	(text "Pin3 - DETECT"
		(exclude_from_sim no)
		(at 261.62 53.594 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "6a3df4eb-d5cd-43ef-9b72-2db5b7097e95")
	)
	(text "UART_RX Pin is a one way communication line\nfrom the sensor to the Base,\nsending small data like ID or charging status"
		(exclude_from_sim no)
		(at 151.892 59.944 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "955739ba-de90-476b-9478-7fe3a64a1ce7")
	)
	(text "CHARGING 4-PIN CONNECTOR"
		(exclude_from_sim no)
		(at 257.81 40.386 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 1.016)
				(bold yes)
			)
		)
		(uuid "9faed00a-3460-4f9d-bb67-9a53de007479")
	)
	(text "Pulls the fault line up. \nWhen fault occures it grounds the line.\nMCU can detect via interupt and turn switches off.\nTurning them back on 1by1 can help to detect, which switch faulted."
		(exclude_from_sim no)
		(at 55.88 36.83 0)
		(effects
			(font
				(size 0.8 0.8)
			)
			(justify left)
		)
		(uuid "bec79209-cbdd-4a48-8fc9-a1e5de37c2f4")
	)
	(text "Pin1 - 5V"
		(exclude_from_sim no)
		(at 261.62 48.26 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "daef4b70-4e35-4921-93ef-8a6d364a0360")
	)
